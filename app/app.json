{
  "expo": {
    "name": "gow3-ios",
    "slug": "gow3-ios",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.gow3ios.app",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "stikdebug"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      },
      "entitlements": {
        "get-task-allow": true,
        "com.apple.developer.kernel.increased-memory-limit": true
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "ccacheEnabled": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "860d64ad-03e3-4f59-aa15-3d5d25a9ceac"
      }
    },
    "owner": "mohin.shaikh",
    "updates": {
      "url": "https://u.expo.dev/860d64ad-03e3-4f59-aa15-3d5d25a9ceac",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "fallbackToCacheTimeout": 5000
    }
  }
}
